    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "sockjs": "~0.3.19",
    "traverse": "~0.6.7",
    "unzip-stream": "^0.3.4",
    "v-tooltip": "~2.1.3",
    "vosk-cli": "https://github.com/n-air-app/vosk-cli/releases/download/1.0.2/vosk-cli-v1.0.2-windows-x64.tar.gz",
    "vue": "2.7.14",
    "vue-color": "2.8.1",
    "vue-i18n": "7.8.1",
    "vue-multiselect": "2.1.9",
    "vue-popperjs": "2.3.0",
    "vue-property-decorator": "7.3.0",
    "vue-slider-component": "2.8.16",
    "vuedraggable": "2.24.3",
    "vuex": "3.1.1",
    "xml2js": "^0.6.2"
  },
