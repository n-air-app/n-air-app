{
  "name": "n-air-app",
  "version": "1.1.20260209-unstable.1",
  "description": "Streaming application for niconico",
  "license": "GPL-3.0",
  "author": "DWANGO Co.,Ltd.",
  "main": "main.js",
  "scripts": {
    "clear": "shx rm -rf bundles/media",
    "clear:cache": "npx shx rm -rf node_modules/.cache dist bundles test-dist additional/.cache",
    "clear-plugins": "shx rm -rf plugins",
    "compile": "pnpm clear && webpack-cli --progress --mode development",
    "compile:ci": "pnpm clear && webpack-cli --mode development",
    "compile:production": "pnpm clear && webpack-cli --progress --mode production",
    "compile-tests": "tsc -p test",
    "dev": "run-p dev:*",
    "dev:server": "webpack-cli serve --progress --hot --mode development",
    "dev:start": "cross-env NAIR_UNSTABLE=1 DEV_SERVER=\"http://localhost:8080/index.dev.html\" electron . && echo 'electron exited.'",
    "format": "eslint --fix {app,test,nvoice}/**/*.{ts,js,vue} && stylelint --fix app/**/*.{vue,css,less} && npx sort-package-json",
    "postinstall": "node additional/main.mjs",
    "lint": "eslint {app,test,nvoice}/**/*.{ts,js,vue} && stylelint app/**/*.{vue,css,less}",
    "package": "pnpm run package:public-stable",
    "package:internal-stable": "shx rm -rf dist && pnpm install --dir bin --ignore-workspace && node bin/convert-to-shiftjis.js AGREEMENT && electron-builder build -w --x64 --config electron-builder/internal-stable.config.js",
    "package:internal-unstable": "shx rm -rf dist && pnpm install --dir bin --ignore-workspace && node bin/convert-to-shiftjis.js AGREEMENT && electron-builder build -w --x64 --config electron-builder/internal-unstable.config.js",
    "package:local": "shx rm -rf dist && pnpm install --dir bin --ignore-workspace && node bin/convert-to-shiftjis.js AGREEMENT && electron-builder build -w --x64 --config electron-builder/local.config.js",
    "package:public-stable": "shx rm -rf dist && pnpm install --dir bin --ignore-workspace && node bin/convert-to-shiftjis.js AGREEMENT && electron-builder build -w --x64 --config electron-builder/stable.config.js",
    "package:public-unstable": "shx rm -rf dist && pnpm install --dir bin --ignore-workspace && node bin/convert-to-shiftjis.js AGREEMENT && electron-builder build -w --x64 --config electron-builder/unstable.config.js",
    "patch-note": "pnpm install --dir bin --ignore-workspace && pnpm --dir bin run patch-note",
    "release": "pnpm install --dir bin --ignore-workspace && pnpm --dir bin run release",
    "screentest": "node test/screentest/runner.js",
    "start": "node bin/start-with-auto-env.js",
    "start:stable": "electron .",
    "start:unstable": "cross-env NAIR_UNSTABLE=1 electron .",
    "test": "node bin/i18n-early-check.js && tsc -p test && ava -v -s",
    "test:unit": "pnpm run test:unit:app && pnpm run test:unit:bin",
    "test:unit:app": "jest --silent --config ./jest.config.js",
    "test:unit:bin": "pnpm install --dir bin --ignore-workspace && jest --silent --config ./jest.bin-config.js",
    "update-gamecapture": "node bin/update-gamecapture.js",
    "version": "git add app/services/patch-notes/notes.ts",
    "watch": "pnpm clear && webpack-cli --watch --progress --mode development",
    "webfont": "pnpm install --dir bin --ignore-workspace && pnpm --dir bin run webfont"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "eslint"
    ],
    "*.{css,less,vue}": [
      "stylelint"
    ],
    "app/i18n/*/*.json": [
      "node ./bin/i18n-early-check.js"
    ],
    "{app/fonts/glyphs/*.svg,app/styles/custom-icons.less.njk}": [
      "pnpm run webfont",
      "git add app/fonts/n-air.woff app/styles/custom-icons.less"
    ]
  },
  "browserslist": [
    "chrome >= 122"
  ],
  "ava": {
    "files": [
      "test-dist/test/e2e/*.js",
      "test-dist/test/api/*.js"
    ],
    "timeout": "3m"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "@n-air-app/n-voice-package": "^1.0.2",
    "@n-air-app/nicolive-comment-protobuf": "2025.1117.170000",
    "@sentry/electron": "7.4.0",
    "@sentry/vue": "10.27.0",
    "color-picker": "https://github.com/n-air-app/native-deps/releases/download/osn0.25.56/color-picker-1.3.11-win64.tar.gz",
    "crash-handler": "https://github.com/n-air-app/native-deps/releases/download/osn0.25.56/crash-handler-1.2.23-win64.tar.gz",
    "electron-updater": "6.6.2",
    "electron-window-state": "5.0.3",
