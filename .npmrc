@n-air-app:registry=https://npm.pkg.github.com

# Git依存関係をHTTPS経由でクローン（CI環境でSSH鍵不要）
git-shallow-hosts=github.com

# ネイティブモジュールの相対パス参照を壊さないために必須
node-linker=hoisted
shamefully-hoist=true

# パッケージリリース後の安全期間
# 新規リリースから7日間（10080分）経過するまでインストールを待機
# セキュリティリスク軽減のため
minimum-release-age=10080
# 内製パッケージは除外
minimum-release-age-exclude=@n-air-app/*
